# Copy to .env and adjust for your environment.
#
# WARNING: every REACT_APP_* value is compiled into the production JavaScript
# bundle and is readable by anyone who loads the site. Never put a private
# secret here - only public configuration.

# Base URL of the CowTrack API. Live updates are served as server-sent events
# from /realtime/stream underneath it, on the same origin, so there is no
# separate socket endpoint to configure.
REACT_APP_API_URL=/api

# Copy to .env and adjust for your environment.
#
# WARNING: every REACT_APP_* value is compiled into the production JavaScript
# bundle and is readable by anyone who loads the site. Never put a private
# secret here - only public configuration.

# Base URL of the CowTrack API.
REACT_APP_API_URL=/api

# WebSocket endpoint. The backend has no WebSocket support yet, so this is
# currently unused.
REACT_APP_WS_URL=/ws
